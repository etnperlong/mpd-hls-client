{
	"name": "mpd-hls-client",
	"version": "1.3.0",
	"description": "Type-safe server-side client for the CharmingStreamer (MPD-HLS) management API",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"README_ZH.md"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.js"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "bun run build:js && bun run build:types",
		"build:js": "bun build src/index.ts src/schemas/index.ts --outdir dist --target node --format esm --packages external",
		"build:types": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:runtimes": "bun run build && bun scripts/runtime-smoke.mjs && node scripts/runtime-smoke.mjs && deno run scripts/runtime-smoke.mjs",
		"test:types:node": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck scripts/node-next-smoke.ts",
		"lint": "biome check --write .",
		"lint:check": "biome check ."
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@commitlint/types": "^21.1.0",
		"@types/bun": "^1.3.14",
		"@types/lodash-es": "^4.17.12",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"lodash-es": "^4.18.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"typescript": ">=5.5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
